# --- App ---
ENV=development
# No API_BASE_URL — OAuth redirect URIs point at FRONTEND_URL's own /api
# proxy (ADR 0024), never at this service's own domain.
FRONTEND_URL=http://localhost:3000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Login OAuth apps (identity-only scopes) ---
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
SLACK_LOGIN_CLIENT_ID=
SLACK_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# --- Connector OAuth apps (broad, data-access scopes — see ADR 0003) ---
GITHUB_CONNECTOR_CLIENT_ID=
GITHUB_CONNECTOR_CLIENT_SECRET=
SLACK_CONNECTOR_CLIENT_ID=
SLACK_CONNECTOR_CLIENT_SECRET=
JIRA_CONNECTOR_CLIENT_ID=
JIRA_CONNECTOR_CLIENT_SECRET=

# --- OpenAI: embeddings (ADR 0006, always server-funded) + the free-tier
# LLM search mode default (ADR 0007/0008) ---
OPENAI_API_KEY=
# Free-tier (server-key) LLM-mode searches per user per day — BYOK requests
# bypass this entirely. Optional, defaults to 5. See ADR 0008.
# FREE_LLM_DAILY_LIMIT=5

# --- Embedding provider (ADR 0009) — server-wide, not per-request.
# "openai" (default) or "gemini". Gemini is a genuinely free stand-in (no
# billing account needed, get a key at aistudio.google.com/apikey) for
# testing before OpenAI billing is set up.
# EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

# --- Observability ---
SENTRY_DSN=
