# --- App ---
ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Login OAuth apps (identity-only scopes) ---
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
SLACK_LOGIN_CLIENT_ID=
SLACK_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# --- Connector OAuth apps (broad, data-access scopes — see ADR 0003) ---
GITHUB_CONNECTOR_CLIENT_ID=
GITHUB_CONNECTOR_CLIENT_SECRET=
SLACK_CONNECTOR_CLIENT_ID=
SLACK_CONNECTOR_CLIENT_SECRET=
JIRA_CONNECTOR_CLIENT_ID=
JIRA_CONNECTOR_CLIENT_SECRET=

# --- OpenAI: embeddings (ADR 0006) + context-search synthesis (ADR 0007) ---
OPENAI_API_KEY=

# --- Observability ---
SENTRY_DSN=
